PORT=3000
# PostgreSQL connection string (Neon or any PostgreSQL) with TLS enabled.
# Leave empty in development to use an embedded PostgreSQL stored in ./data/pglite.
DATABASE_URL=
REQUIRE_POSTGRES=false
COMPANY_NAME=Laxmi India Finance Ltd.
REPORT_TIMEZONE=Asia/Kolkata
# Set to production on Railway; use HTTPS there.
NODE_ENV=development
# Used only by npm run bootstrap; do not commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional: a unique random code enables one-time administrator setup in the web portal.
# Remove after first administrator creation. Never commit real values.
SETUP_TOKEN=
# Optional: lets the Laxmi assistant answer free-text questions with Claude.
# Leave empty to answer from rules, the knowledge base and policies only.
ANTHROPIC_API_KEY=
BOT_MODEL=claude-opus-5-5
